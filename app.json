{
  "expo": {
    "name": "HostelHub",
    "slug": "hostel-hub",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "hostelhub",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "android": {
      "package": "com.hostelhub.app",
      "versionCode": 1,
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/icon.png",
        "backgroundColor": "#2563eb"
      },
      "permissions": [
        "CAMERA",
        "READ_EXTERNAL_STORAGE",
        "WRITE_EXTERNAL_STORAGE"
      ],
      "statusBar": {
        "barStyle": "light-content",
        "backgroundColor": "#2563eb"
      }
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.hostelhub.app"
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": ["expo-font", "expo-web-browser"],
    "extra": {
      "supabaseUrl": "https://hskyhmnjvnshbiczklev.supabase.co",
      "supabaseAnonKey": "sb_publishable_o2qWOea1C8LrdtFY0gKm5Q_KXE2ZSI3"
    }
  }
}
